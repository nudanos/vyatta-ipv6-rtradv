#!/usr/bin/perl
# SPDX-License-Identifier: GPL-2.0-only
#
# vyatta_gen_radvd.pl: the radvd.conf sections and errors it writes for the
# configs in t/data, as recorded from the script before the 2026 lint fixes
# (UPDATE_GOLDEN=1 re-records). radvd.conf's parameter order follows Perl's
# hash order, so the lines are compared sorted; the "Generated by" line
# carries the user and date and is left out.

use strict;
use warnings;
use File::Copy qw(copy);
use File::Temp qw(tempdir);
use FindBin;
use Test::More;

my $t      = $FindBin::Bin;
my $script = $ENV{GEN_RADVD} // "$t/../scripts/vyatta_gen_radvd.pl";

sub slurp {
    my ($path) = @_;
    open my $fh, '<', $path or return q{};
    local $/ = undef;
    my $s = <$fh>;
    close $fh or return q{};
    return $s;
}

# run the script on a copy of existing.conf; returns its exit status,
# output and the resulting conf
sub run_script {
    my ( $cfg, @args ) = @_;
    my $dir = tempdir( CLEANUP => 1 );
    copy( "$t/data/existing.conf", "$dir/radvd.conf" ) or die "$!\n";
    local $ENV{VYATTA_RADVD_CONF}  = "$dir/radvd.conf";
    local $ENV{VYATTA_TEST_CONFIG} = "$t/data/$cfg";
    my $out = qx{$^X -I$t/lib $script @args 2>&1};    ## no critic (InputOutput::ProhibitBacktickOperators) reason: the test runs the script and reads its output
    return ( $? >> 8, $out, slurp("$dir/radvd.conf") );
}

sub normalized {
    my ($conf) = @_;
    return join q{}, sort grep { !/Generated[ ]by/x } split /^/mx, $conf;
}

sub is_golden {
    my ( $got, $name ) = @_;
    my $path = "$t/data/$name";
    if ( $ENV{UPDATE_GOLDEN} ) {
        open my $fh, '>', $path or die "$path: $!\n";
        print {$fh} $got;
        close $fh or die "$path: $!\n";
    }
    return is( $got, slurp($path), $name );
}

my @cfgs = qw(defaults custom small-interval bad-max-high bad-max-low bad-min-low
  bad-min-high bad-lifetime-low bad-lifetime-high bad-prefix);
foreach my $cfg (@cfgs) {
    my ( $status, $out, $conf ) = run_script( "$cfg.cfg", '--generate', 'dp0s3' );
    is_golden( "exit $status\n$out" . normalized($conf), "$cfg.expected" );
}

my ( $status, $out, $conf ) = run_script( 'defaults.cfg', '--delete', 'dp0s3' );
is_golden( "exit $status\n$out$conf", 'delete.expected' );

done_testing();
